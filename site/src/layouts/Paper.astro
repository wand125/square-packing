---
// A paper page: header block (kicker, title, lead, links, result), contents, then the text in both languages.
// The English and Japanese texts are separate MDX files; their headings make the contents.
import Base from './Base.astro';
import T from '../components/ui/T.astro';
import '../styles/paper.css';
import { tex } from '../lib/tex';
const { file, title, meta, En, Ja, headingsEn, headingsJa } = Astro.props;
const hj = headingsJa.filter((x) => x.depth === 2);
const toc = headingsEn.filter((h) => h.depth === 2).map((h, i) => ({ en: h, ja: hj[i] || h }));
---
<Base file={file} title={title} katex>
<div class={meta.wide ? 'paper pp-wide' : 'paper'}>
  <details class="pp-toc" open><summary class="dim"><T en="Contents" ja="目次" /></summary>
    <ol>{toc.map((t) => <li><a data-l="en" href={'#' + t.en.slug}>{t.en.text}</a><a data-l="ja" href={'#' + t.ja.slug}>{t.ja.text}</a></li>)}</ol></details>
  <article class="pp-main">
    <header class="pp-head">
      <div class="pp-kicker dim"><span data-l="en" set:html={meta.kicker[0]} /><span data-l="ja" set:html={meta.kicker[1]} /></div>
      <h1><span data-l="en" set:html={meta.titleHtml[0]} /><span data-l="ja" set:html={meta.titleHtml[1]} /></h1>
      <p class="pp-lead"><span data-l="en" set:html={tex(meta.lead[0])} /><span data-l="ja" set:html={tex(meta.lead[1])} /></p>
      <div class="pp-meta dim">{meta.author ?? 'wand125'}</div>
      <div class="pp-links">{meta.links.map((l) => <a class="btn" href={l[2]}><T en={l[0]} ja={l[1]} /></a>)}</div>
      <div class="pp-result" set:html={meta.resultHtml} />
    </header>
    <div data-l="en"><En /></div>
    <div data-l="ja"><Ja /></div>
  </article>
</div>
<button type="button" class="pp-toc-btn desk-hide" aria-label="contents"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
<dialog class="issue-pop pp-toc-pop" aria-label="contents"><ol>{toc.map((t) => <li><a data-l="en" href={'#' + t.en.slug}>{t.en.text}</a><a data-l="ja" href={'#' + t.ja.slug}>{t.ja.text}</a></li>)}</ol></dialog>
<script is:inline>
(function () {
 var pop = document.querySelector('.pp-toc-pop'), btn = document.querySelector('.pp-toc-btn');
 btn.addEventListener('click', function () { pop.showModal(); });
 pop.addEventListener('click', function (e) { if (e.target === pop || e.target.closest('a')) pop.close(); });
 // phones: hide the bars while reading downwards, show them when scrolling up or near the top
 var last = window.scrollY;
 window.addEventListener('scroll', function () {
  if (!window.matchMedia('(max-width: 600px), (pointer: coarse) and (max-width: 900px)').matches) return;
  var y = window.scrollY; document.body.classList.toggle('reading', y > last && y > 120); last = y;
 }, { passive: true });
})();
</script>
</Base>
