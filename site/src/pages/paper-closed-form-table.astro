---
import Base from '../layouts/Base.astro';
import T from '../components/ui/T.astro';
import '../styles/interactive.css';
---
<Base file="paper-closed-form-table.html" title="Closed-Form Bound Table">
<div class="cft">
<p><a class="btn" href="paper-closed-form.html">← <T en="A closed-form lower bound for s(N)" ja="s(N) の閉じた式の下界" /></a></p>
<h1><T en="Lower bounds for N ≤ 3600" ja="N ≤ 3600 の下界の表" /></h1>
<p class="note"><T en="For every N from 1 to 3600: the bound a(N) of the closed form (N ≥ 49, non-square), the best known lower and upper bounds with their source and year, Karakuş's formula, and the differences. Lower bounds are rounded down and upper bounds rounded up to 9 decimals." ja="1〜3600 のすべての N について：閉じた式の下界 a(N)（N ≥ 49、平方数でない）、既知の最良の下界と上界（出典と年）、Karakuş の式、その差。下界は 9 桁で切り下げ、上界は切り上げて出す。" /></p>
<ul class="note">
<li><T en="Known lower bounds: evand/square-packing lower_bounds.json (published values only), our published certificates (INDEX.json of this repository), and Karakuş's formula (arXiv:2609.37410, Corollary 6.2); a result counts when it is shown by a published certificate or paper. Since s is nondecreasing, the bound for N is the largest over M ≤ N (marked 'from N = M'). The area bound √N is the floor." ja="既知の下界：evand/square-packing の lower_bounds.json（公開された値のみ）、当リポジトリの公開済みの証明書（INDEX.json）、Karakuş の式（arXiv:2609.37410, Corollary 6.2）。公開された証明書・論文で示された結果を数える。s は非減少なので、N の下界は M ≤ N の最大をとる（「from N = M」と表示）。面積の下界 √N が最低限。" /></li>
<li><T en="s(k² − 4) = k for k ≥ 5 is a preprint result of Evan Daniel (evand/square-packing; jlevy/squares#316). Its reduction (all k, D4, the θ = 0 face) is checked in the Lean kernel there; for k ≥ 8 it rests on the finite statement ValidTilt9, which we independently re-checked with a separately written exact checker (computer-assisted; records-tilt9-v1). A Lean formalization of ValidTilt9 is in progress. It is cited at N = 60, 77 and 96 too; the note column marks our independent re-checks and certificates." ja="k ≥ 5 の s(k² − 4) = k は Evan Daniel の preprint の結果（evand/square-packing。jlevy/squares#316）。帰着の部分（すべての k、D4、θ = 0 の面）はそこで Lean のカーネルで検査されている。k ≥ 8 では有限命題 ValidTilt9 に基づき、ValidTilt9 は当方が別に書いた厳密な検査器で独立に再検査した（計算機援用。records-tilt9-v1）。ValidTilt9 の Lean での形式化は進行中。N = 60、77、96 でもこれを出典とし、当方の独立の再検査や証明書は備考の列に示す。" /></li>
<li><T en="Known upper bounds: evand/square-packing timeline.json (finder and year). Where N has no entry, the smallest s(M) with M > N is used (s is nondecreasing), else the trivial ⌈√N⌉, marked trivial." ja="既知の上界：evand/square-packing の timeline.json（発見者と年）。N に記録がなければ M > N の s(M) の最小を使い（s は非減少）、それもなければ自明な ⌈√N⌉（自明と表示）。" /></li>
<li><T en="Reference only: Nagamochi's formula. Its proof has a publicly discussed gap; it is not used as a known bound." ja="参考のみ：Nagamochi の式。証明に公に議論されている穴があり、既知の下界には使わない。" /></li>
</ul>
<div class="bar cft-ctl">
<label>N <input type="number" id="cft-from" min="1" max="3600" value="49" aria-label="from"/> – <input type="number" id="cft-to" min="1" max="3600" value="3600" aria-label="to"/></label>
<label><input type="checkbox" id="cft-nonsq" checked/> <T en="non-square only" ja="平方数を除く" /></label>
<label><input type="checkbox" id="cft-better"/> <T en="a(N) above the known lower bound" ja="a(N) が既知の下界を上回る行" /></label>
<input type="search" id="cft-q" aria-label="filter" data-ph-en="filter by source" data-ph-ja="出典で絞り込み"/>
<label><T en="colour" ja="色分け" /> <select id="cft-mode" aria-label="colour">
<option value="none" data-en="none" data-ja="なし">none</option>
<option value="lb" data-en="a(N) − known lower bound" data-ja="a(N) − 既知の下界">a(N) − known lower bound</option>
<option value="kar" data-en="a(N) − Karakuş" data-ja="a(N) − Karakuş">a(N) − Karakuş</option>
<option value="nag" data-en="a(N) − Nagamochi (ref.)" data-ja="a(N) − Nagamochi（参考）">a(N) − Nagamochi (ref.)</option>
<option value="gap" data-en="gap: upper − lower bound" data-ja="すき間：上界 − 下界">gap: upper − lower bound</option>
<option value="src" data-en="source of the known lower bound" data-ja="既知の下界の出典">source of the known lower bound</option>
</select></label>
<span class="count" id="cft-count" aria-live="polite"></span>
<a class="btn" href="data/papers/closed-form-table.csv" download>CSV</a>
</div>
<p class="cft-summary" id="cft-summary" aria-live="polite"></p>
<p class="note"><T en="The known lower bounds include results that are not peer reviewed (preprints and published certificates, including ours and Evan Daniel's s(k² − 4) = k); the status column shows which." ja="既知の下界には、査読を経ていない結果（preprint と公開された証明書。当方のものと Evan Daniel の s(k² − 4) = k を含む）も含めている。どれがそうかは状態の列に示す。" /></p>
<div class="cft-legend" id="cft-legend" aria-live="polite"></div>
<div class="wrap"><table class="cft-table"><thead><tr id="cft-head"></tr></thead><tbody id="cft-body"></tbody></table></div>
<p><button type="button" id="cft-more" class="btn" hidden><T en="show more" ja="さらに表示" /></button></p>
</div>
<script>
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ja = () => document.documentElement.lang === 'ja';
// shown columns: [key, en, ja, kind]; kind n = number (sorts numerically), d = difference (coloured)
const COLS: [string, string, string, string][] = [
 ['N', 'N', 'N', 'n'], ['a_N', 'a(N)', 'a(N)', 'n'], ['a_interval', 'interval', '区間', 'n'],
 ['known_lb', 'known lower bound', '既知の下界', 'n'], ['known_lb_source', 'source', '出典', 't'], ['known_lb_year', 'year', '年', 'n'], ['known_lb_status', 'status', '状態', 't'], ['known_lb_note', 'note', '備考', 't'],
 ['known_ub', 'known upper bound', '既知の上界', 'n'], ['known_ub_source', 'source', '出典', 't'], ['known_ub_year', 'year', '年', 'n'],
 ['karakus', 'Karakuş', 'Karakuş', 'n'], ['ref_nagamochi', 'Nagamochi (ref.)', 'Nagamochi（参考）', 'n'],
 ['a_minus_known_lb', 'a − known lb', 'a − 既知の下界', 'd'], ['a_minus_karakus', 'a − Karakuş', 'a − Karakuş', 'd'],
 ['a_minus_nagamochi', 'a − Nagamochi', 'a − Nagamochi', 'd'], ['known_ub_minus_a', 'known ub − a', '既知の上界 − a', 'd'],
];
let data: Record<string, string>[] = [], view: Record<string, string>[] = [], sortKey = 'N', sortDir = 1, shown = 300;
const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
function head() {
 $('cft-head').innerHTML = COLS.map(([k, en, jp]) => `<th data-k="${k}" class="${k === sortKey ? 'on' : ''}" aria-sort="${k === sortKey ? (sortDir > 0 ? 'ascending' : 'descending') : 'none'}">${ja() ? jp : en}${k === sortKey ? (sortDir > 0 ? ' ↑' : ' ↓') : ''}</th>`).join('');
}
function cell(r: Record<string, string>, k: string, kind: string) {
 const v = r[k] ?? '';
 if (v === '') return '<td class="dim">—</td>';
 if (k === 'known_ub_source' && r.known_ub_trivial) return `<td>${ja() ? '自明' : 'trivial'}</td>`;
 if (kind === 'd') { const x = +v; return `<td class="num ${x > 1e-9 ? 'cft-pos' : x < -1e-9 ? 'cft-neg' : ''}">${x > 0 ? '+' : ''}${v}</td>`; }
 const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
 const link = k === 'known_lb_source' ? r.known_lb_url : k === 'known_lb_note' ? r.known_lb_note_url : '';
 if (link) return `<td><a href="${esc(link)}">${esc(v)}</a></td>`;
 return `<td class="${kind === 't' ? '' : 'num'}">${esc(v)}</td>`;
}
// colour modes: a pale band on each row, from the colour tokens (light and dark themes)
const MODES: Record<string, string> = {lb: 'a_minus_known_lb', kar: 'a_minus_karakus', nag: 'a_minus_nagamochi'};
// muted colours from the site tokens (mixed toward the neutral grey); the CSS variables are defined below
const POS = 'var(--cft-pos)', NEG = 'var(--cft-neg)', GREY = 'var(--cft-grey)';
const SRC_COL = ['var(--cft-c1)', 'var(--cft-c2)', 'var(--cft-c3)', 'var(--cft-c4)', 'var(--cft-c5)', 'var(--cft-c6)'];
// four steps of shade (no smooth gradient), at most 17% opacity; the step grows with the square root of the share
const STEPS = [5, 9, 13, 17];
const band = (col: string, t: number) => `color-mix(in srgb, ${col} ${STEPS[Math.min(3, Math.max(0, Math.ceil(Math.sqrt(Math.max(0, Math.min(1, t))) * 4) - 1))]}%, transparent)`;
const steps = (col: string) => [0.01, 0.1, 0.4, 1].map(t => `<span class="sw" style="background:${band(col, t)}"></span>`).join('');
// a legend swatch is small, so it shows the colour itself at a fixed, stronger shade
const swatch = (col: string) => `<span class="sw" style="background:color-mix(in srgb, ${col} 45%, transparent)"></span>`;
const srcKey = (r: Record<string, string>) => r.known_lb_source.replace(/\s*\(.*$/, '').replace(/^"+/, '');
let mode = 'none', srcMap: Record<string, string> = {};
function getMode() { const h = location.hash.match(/^#mode-(\w+)$/); if (h && (h[1] in MODES || ['none', 'gap', 'src'].includes(h[1]))) return h[1];
 try { return localStorage.getItem('cft-mode') || 'none'; } catch (e) { return 'none'; } }
function setMode(m: string) { mode = m; try { localStorage.setItem('cft-mode', m); } catch (e) {} try { history.replaceState(null, '', m === 'none' ? location.pathname : '#mode-' + m); } catch (e) {} render(); }
function colours(rows: Record<string, string>[]) {
 const out = new Map<Record<string, string>, string>(), leg = $('cft-legend');
 if (mode === 'none') { leg.innerHTML = ''; return out; }
 if (mode in MODES) {
  const k = MODES[mode], vals = rows.map(r => r[k] === '' ? NaN : +r[k]).filter(x => !isNaN(x)), m = Math.max(1e-9, ...vals.map(Math.abs));
  rows.forEach(r => { if (r[k] === '') return; const x = +r[k]; if (Math.abs(x) <= 1e-9) return; out.set(r, band(x > 0 ? POS : NEG, Math.abs(x) / m)); });
  leg.innerHTML = `${steps(POS)}${ja() ? '上回る（濃いほど差が大きい、4 段）' : 'above (darker = larger, 4 steps)'} ${steps(NEG)}${ja() ? '下回る' : 'below'} <span class="sw sw0"></span>${ja() ? '差 0 または空欄' : 'equal or blank'} <span class="dim">${ja() ? '濃さの基準' : 'full shade at'} |Δ| = ${m.toFixed(4)}</span>`;
 } else if (mode === 'gap') {
  const g = (r: Record<string, string>) => r.known_ub === '' || r.known_lb === '' ? NaN : +r.known_ub - +r.known_lb;
  const vals = rows.map(g).filter(x => !isNaN(x)), m = Math.max(1e-9, ...vals);
  rows.forEach(r => { const x = g(r); if (isNaN(x)) return; out.set(r, band(POS, 1 - x / m)); });
  leg.innerHTML = `${steps(POS)}${ja() ? 'すき間が小さいほど濃い（4 段）' : 'darker = smaller gap (4 steps)'} <span class="sw" style="background:${band(POS, 0)}"></span>${ja() ? '大きい' : 'large'} <span class="dim">${ja() ? '最大' : 'largest'} ${m.toFixed(4)}</span>`;
 } else {
  const counts: Record<string, number> = {}; data.forEach(r => { const s = srcKey(r); counts[s] = (counts[s] || 0) + 1; });
  const order = Object.keys(counts).sort((a, b) => counts[b] - counts[a]); srcMap = {};
  order.forEach((s, i) => { srcMap[s] = i < SRC_COL.length ? SRC_COL[i] : GREY; });
  rows.forEach(r => out.set(r, band(srcMap[srcKey(r)], 0.4)));
  const shownSrc = order.filter(s => rows.some(r => srcKey(r) === s));
  leg.innerHTML = shownSrc.slice(0, SRC_COL.length).map(s => `${swatch(srcMap[s])}${s}`).join(' ') + (shownSrc.length > SRC_COL.length ? ` ${swatch(GREY)}${ja() ? 'その他' : 'others'}` : '');
 }
 return out;
}
function rowsNow() { return data; }
// the counts over all non-square N ≥ 49 (independent of the filters), as in the paper
function summary(rows: Record<string, string>[]) {
 let up = 0, eq = 0, dn = 0;
 rows.forEach(r => { if (r.a_N === '') return; const x = +r.a_minus_known_lb; if (x > 1e-9) up++; else if (x < -1e-9) dn++; else eq++; });
 $('cft-summary').textContent = ja()
  ? `N ≤ 3600 の平方数でない N ≥ 49 で、a(N) が既知の下界を上回る ${up.toLocaleString()} 個・等しい ${eq} 個・下回る ${dn} 個。`
  : `Over the non-square N ≥ 49 up to 3600, a(N) is above the known lower bound at ${up.toLocaleString()}, equal at ${eq} and below at ${dn}.`;
}
function render() {
 const from = +$('cft-from').value || 1, to = +$('cft-to').value || 3600, nonsq = $('cft-nonsq').checked, better = $('cft-better').checked, q = $('cft-q').value.trim().toLowerCase();
 const kind = COLS.find(c => c[0] === sortKey)![3];
 const base = rowsNow(); summary(base);
 view = base.filter(r => +r.N >= from && +r.N <= to && (!nonsq || !r.square) && (!better || +r.a_minus_known_lb > 1e-9)
  && (!q || (r.known_lb_source + ' ' + r.known_ub_source).toLowerCase().includes(q)));
 view.sort((a, b) => { const x = a[sortKey], y = b[sortKey]; if (x === '' && y !== '') return 1; if (y === '' && x !== '') return -1;
  return (kind === 't' ? x.localeCompare(y) : (+x - +y)) * sortDir || (+a.N - +b.N); });
 const col = colours(view);
 $('cft-body').innerHTML = view.slice(0, shown).map(r => { const c = col.get(r); return (c ? `<tr style="background:${c}">` : '<tr>') + COLS.map(([k, , , kd]) => cell(r, k, kd)).join('') + '</tr>'; }).join('');
 ($('cft-mode') as unknown as HTMLSelectElement).querySelectorAll('option').forEach(o => { o.textContent = ja() ? o.dataset.ja! : o.dataset.en!; });
 $('cft-count').textContent = ja() ? `${view.length} 行` : `${view.length} rows`;
 $('cft-more').hidden = view.length <= shown;
 head();
}
fetch(BASE + 'data/papers/closed-form-table.json').then(r => r.json()).then(d => {
 data = d.rows.map((row: string[]) => Object.fromEntries(d.columns.map((c: string, i: number) => [c, String(row[i] ?? '')])));
 render();
}).catch(() => { $('cft-count').textContent = 'Could not load the table.'; });
['cft-from', 'cft-to', 'cft-nonsq', 'cft-better', 'cft-q'].forEach(id => $(id).addEventListener('input', () => { shown = 300; render(); }));
mode = getMode(); ($('cft-mode') as unknown as HTMLSelectElement).value = mode;
$('cft-mode').addEventListener('change', () => setMode($('cft-mode').value));
window.addEventListener('hashchange', () => { const m = getMode(); if (m !== mode) { mode = m; ($('cft-mode') as unknown as HTMLSelectElement).value = m; render(); } });
$('cft-more').addEventListener('click', () => { shown += 300; render(); });
$('cft-head').addEventListener('click', e => { const th = (e.target as Element).closest('th'); if (!th) return; const k = th.dataset.k!; sortDir = k === sortKey ? -sortDir : 1; sortKey = k; render(); });
document.addEventListener('langchange', render);
new MutationObserver(render).observe(document.documentElement, {attributes: true, attributeFilter: ['lang']});
</script>
<style is:global>
.cft-summary { font-size: 13px; margin: 6px 0 2px; }
.cft-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 12px; min-height: 18px; margin: 4px 0 8px; }
.cft-legend .sw { display: inline-block; width: 22px; height: 12px; border: 1px solid var(--line); vertical-align: middle; margin-right: 2px; }
.cft-legend .sw0 { background: transparent; }
.cft h1 { font-size: 20px; margin: 8px 0; }
.cft-ctl { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; margin: 10px 0; }
.cft-ctl input[type="number"] { width: 6em; }
.cft-table { font-size: 12px; font-variant-numeric: tabular-nums; border-collapse: collapse; }
.cft-table th { cursor: pointer; white-space: nowrap; position: sticky; top: 0; background: var(--bg); }
.cft-table th.on { color: var(--acc); }
.cft-table td { padding: 3px 8px; white-space: nowrap; border-bottom: 1px solid var(--line); }
.cft-pos { color: var(--cft-pos); }
.cft-neg { color: var(--cft-neg); }
/* muted palette from the tokens: dull blue-green and red-brown for the sign, six low-saturation colours for sources */
.cft { --cft-pos: color-mix(in srgb, color-mix(in srgb, var(--ok) 50%, var(--link)) 65%, var(--fg2));
  --cft-neg: color-mix(in srgb, color-mix(in srgb, var(--bad) 60%, var(--acc)) 65%, var(--fg2));
  --cft-grey: var(--fg2);
  --cft-c1: color-mix(in srgb, var(--link) 55%, var(--fg2)); --cft-c2: color-mix(in srgb, var(--ok) 55%, var(--fg2));
  --cft-c3: color-mix(in srgb, var(--acc) 55%, var(--fg2)); --cft-c4: color-mix(in srgb, var(--bad) 50%, var(--fg2));
  --cft-c5: color-mix(in srgb, color-mix(in srgb, var(--link) 50%, var(--bad)) 50%, var(--fg2)); --cft-c6: color-mix(in srgb, color-mix(in srgb, var(--ok) 50%, var(--acc)) 50%, var(--fg2)); }
</style>
</Base>
