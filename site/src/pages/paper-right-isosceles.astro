---
import Paper from '../layouts/Paper.astro';
import * as En from '../content/papers/right-isosceles/en.mdx';
import * as Ja from '../content/papers/right-isosceles/ja.mdx';
import meta from '../content/papers/right-isosceles/meta.json';
import { tex } from '../lib/tex';
const m = { ...meta, titleHtml: meta.title.map(tex), resultHtml: '<span data-l="en">' + tex(meta.result[0]) + '</span><span data-l="ja">' + tex(meta.result[1]) + '</span>' };
---
<Paper file="paper-right-isosceles.html" title="Unit Squares in a Right Isosceles Triangle" meta={m}
  En={En.default} Ja={Ja.default} headingsEn={En.getHeadings()} headingsJa={Ja.getHeadings()} />
