    </div></div>
    <span class="c4s-chips"><button type="button" data-split><T en="Two cubes" ja="二重立方体" /></button><button type="button" data-oct><T en="Octagon" ja="八角形" /></button><button type="button" data-view="0"><T en="Oblique" ja="斜め" /></button><button type="button" data-view="1"><T en="Top" ja="上" /></button><button type="button" data-view="2"><T en="Side" ja="横" /></button><button type="button" data-spin aria-pressed="false"><T en="Rotate" ja="回す" /></button><button type="button" data-spin4 aria-pressed="false"><T en="Turn in 4D" ja="4 次元で回す" /></button></span>
  </div>
  <dl class="c4s-dl">
    <dt><T en="published" ja="公開値" /></dt><dd class="num">{r.published.value}{conjectured(r) ? <> (<T en={`conjectured by the source: ${r.published.form.split(' ≈')[0]}`} ja={`出典の予想：${r.published.form.split(' ≈')[0]}`} />)</> : r.published.form && r.published.form.startsWith('2') ? <> ({r.published.form.split(' ≈')[0]})</> : r.published.form ? <> ({r.published.form})</> : ''}</dd>
    <dt><T en="ours − published" ja="当方 − 公開値" /></dt><dd class="num">{r.s_exact && r.published.form.startsWith(r.s_exact) ? (conjectured(r) ? <T en="0 (the conjectured closed form, exactly)" ja="0（予想された閉じた式にちょうど一致）" /> : <T en="0 (exact)" ja="0（厳密）" />) : diff(r)}</dd>
    <dt><T en="source" ja="出典" /></dt><dd><a href={r.published.url}>{r.published.source}</a></dd>
