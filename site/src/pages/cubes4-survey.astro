---
// A survey of the packings of k unit 4-cubes, k = 17 to 30, each with an exact certificate. Data: public/data/
// cubes4-survey.json, gathered by tools/cubes4_survey.py from the survey materials of problems/cubes-n-dim. Each cube is drawn as its projection to three dimensions.
import {readFileSync} from 'node:fs';
import Base from '../layouts/Base.astro';
import T from '../components/ui/T.astro';
import '../styles/paper.css';
type Cube = {c: number[]; R: number[][]; axis_parallel: boolean};
type Row = {k: number; s_float: number; published: {value: string; form: string; source: string; url: string; commit: string};
  origin_kind: string; origin?: string; starting_point_author: string | null; release: string | null;
  certificate: {file: string; sha256: string; checked_by_two_systems: boolean}; cubes: Cube[]; s_exact?: string};
const rows: Row[] = JSON.parse(readFileSync('public/data/cubes4-survey.json', 'utf8')).rows;
// tilt: the largest angle between an edge (a column of R) and the nearest coordinate axis
const tilt = (q: Cube) => Math.acos(Math.min(1, Math.min(...[0, 1, 2, 3].map(j => Math.max(...q.R.map(r => Math.abs(r[j]))))))) * 180 / Math.PI;
const GH = 'https://github.com/wand125/square-packing/blob/main/';
// the k whose published sides agree to 4 decimals (18–25: 2.7071; 26–29: 2.9428) share one place in the grid: the
// card of the largest k is shown, the chips switch between them
const side4 = (r: Row) => parseFloat(r.published.value).toFixed(4);
const groupOf = (r: Row) => rows.filter(o => side4(o) === side4(r)).map(o => o.k);
// the published value to compare with: the closed form 2 + 1/√m when the source gives one, else the printed decimal
const target = (r: Row) => { const m = r.published.form.match(/^2 \+ 1\/√(\d+)/); return m ? 2 + 1 / Math.sqrt(+m[1]) : parseFloat(r.published.value); };
// ours − published, as ±m × 10^e with a superscript exponent
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
function diff(r: Row): string {
  const d = r.s_float - target(r), [m, e] = Math.abs(d).toExponential(1).split('e');
  return (d > 0 ? '+' : '−') + m + ' × 10' + (e.startsWith('-') ? '⁻' : '') + e.replace(/^[+-]/, '').split('').map(c => SUP[+c]).join('');
}
// how the packing was made, from the origin text of the survey (a subset, the frames-and-LP rebuild, the product)
function origin(r: Row): [string, string] {
  const o = r.origin ?? '', a = r.starting_point_author, sub = o.match(/subset of our k = (\d+)/);
  if (sub) return [`the packing of k = ${sub[1]} with cubes removed`, `k = ${sub[1]} の配置から立方体を除いたもの`];
  if (/frames fixed to signed permutations/.test(o)) return [`from the published packing of ${a}: frames set to signed permutations and 45° turns, centres re-solved by a linear programme`, `${a} の公開の配置から：枠を符号付きの置換と 45° の回転に固定し、中心を線形計画で解き直した`];
  if (/product of two 5-square packings/.test(o)) return ['ours: the product of two packings of 5 squares in the square of side 2 + 1/√2', '当方の構成：辺 2 + 1/√2 の正方形に 5 個の正方形を入れた配置 2 つの積'];
  if (r.origin_kind === 'own-record') return [`container shrinking by us, from the published packing of ${a}`, `${a} の公開の配置から当方が容器を縮めた`];
  if (r.origin_kind === 'external') return [`published coordinates of ${a}, tightened and certified by us`, `${a} の公開座標を当方が締め直し、証明書を付けた`];
  return ['our own search', '当方の探索'];
}
// a closed form the source gives only as a conjecture
const conjectured = (r: Row) => /conjectured/.test(r.published.form);
---
<Base file="cubes4-survey.html" title="Unit 4-Cubes in a 4-Cube">
<div class="c4s">
<h1><T en="Unit 4-cubes in a 4-cube, k = 17 to 30" ja="4 次元の立方体に単位 4 次元立方体 k 個（k = 17〜30）" /></h1>
<p class="c4s-lede"><T en="For each k from 17 to 30: the smallest published container side for k unit 4-cubes, and a packing of ours with an exact certificate, drawn as a parallel projection that turns in four dimensions. A survey of known values; the new values are k = 27, 28, 29 and 30. The values of k whose published sides agree to four decimals (18 to 25, and 26 to 29) share one card, showing the largest k; the numbers at its top switch between them." ja="k = 17〜30 のそれぞれについて、単位 4 次元立方体 k 個の容器の辺の公開値と、厳密な証明書を付けた当方の配置を、4 次元で回る平行投影の図で描く。既知の値の資料で、新しい値は k = 27、28、29、30。公開値が小数 4 桁まで同じ k（18〜25 と 26〜29）は 1 枚のカードにまとめて最も大きい k を表示し、上の数字で切り替える。" /></p>
