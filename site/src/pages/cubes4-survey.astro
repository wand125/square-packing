<script type="application/json" id="c4s-data" set:html={JSON.stringify(rows.map(r => ({k: r.k, s: r.s_float, cubes: r.cubes.map(q => ({c: q.c.map(x => +x.toFixed(7)), R: q.R.map(row => row.map(x => +x.toFixed(7))), ax: q.axis_parallel, t: +tilt(q).toFixed(2)}))})))} />
<div class="c4s-grid">
{rows.map(r => <section class={r.origin_kind === 'own-record' ? 'c4s-card rec' : 'c4s-card'} id={`k${r.k}`} data-group={groupOf(r).join(',')} hidden={Math.max(...groupOf(r)) !== r.k}>
